# Used by docker-compose.yml. Copy to .env and fill in the secrets.
#
# There are no per-company settings here. A fresh install has zero companies;
# the Platform Owner creates them in the platform console. See README.md.

# ─── Databases ──────────────────────────────────────────────────────────────
# Platform database: company list, platform users, platform roles, audit log.
# The database name comes from PLATFORM_DB_NAME (default logiforce_platform),
# never from the URI path.
PLATFORM_MONGODB_URI=mongodb://mongo:27017
# Every company database lives on this cluster, at MONGODB_BASE_URI/<dbName>.
# No database name in it.
MONGODB_BASE_URI=mongodb://mongo:27017

# ─── Domain ─────────────────────────────────────────────────────────────────
# Companies are served at https://<key>.<APP_DOMAIN> (wildcard DNS) and the
# platform console at https://admin.<APP_DOMAIN>. For local docker use
# "localhost": browsers resolve acme.localhost and admin.localhost to 127.0.0.1.
APP_DOMAIN=localhost

# ─── Secrets (required) ─────────────────────────────────────────────────────
# Generate each with:  openssl rand -hex 32   (they must differ)
JWT_SECRET=
PLATFORM_JWT_SECRET=
JWT_EXPIRES_IN=7d
PLATFORM_JWT_EXPIRES_IN=8h

NODE_ENV=production
PORT=5000

# Extra allowed CORS origins, comma-separated (optional). Every
# https://*.<APP_DOMAIN> and localhost origin is already allowed.
CLIENT_URL=

# ─── Email delivery (Resend) ────────────────────────────────────────────────
# Needed to send sign-in codes and invite / password links. The shared
# "onboarding@resend.dev" sender only delivers to the API key owner's address;
# verify your own domain at https://resend.com/domains for anything else.
RESEND_API_KEY=
EMAIL_FROM=LogiForce <onboarding@resend.dev>
# Local development only: log emails (including codes and links) to the
# server console instead of sending them. NEVER enable in production.
EMAIL_DEV_LOG=false
