PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster-aws.oi55br0.mongodb.net/logiforce?appName=Cluster-aws
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_URL=https://logi-force.vercel.app

# ─── Email delivery ─────────────────────────────────────────────────────────
# Pick ONE of the following. Resend is preferred when both are configured.
#
# Option A — Resend (recommended, no SMTP setup needed)
# Sign up at https://resend.com and grab an API key. The free tier includes
# 3000 emails/month and the default sender "onboarding@resend.dev" works
# without any domain verification, so password reset / OTP emails work out
# of the box.
RESEND_API_KEY=
# Optional: override the From header. Defaults to "LogiForce <onboarding@resend.dev>"
# when using Resend. Set this once you've verified your own domain.
EMAIL_FROM=LogiForce <onboarding@resend.dev>

# Option B — Classic SMTP (legacy / self-hosted)
# Only used when RESEND_API_KEY is empty. Without either provider, the
# password-reset and OTP flows respond with a clear "Email service is not
# configured" error instead of silently dropping the email.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LogiForce <no-reply@yourdomain.com>
