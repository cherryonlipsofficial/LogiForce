PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster-aws.oi55br0.mongodb.net/logiforce?appName=Cluster-aws
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_URL=https://logi-force.vercel.app

# ─── Platform (product-owner) database ──────────────────────────────────────
# Holds the tenant registry, role templates, platform staff accounts and the
# platform audit log. REQUIRED: the server will not start without it.
# It can be the same cluster URI as the tenant databases: the database name
# always comes from PLATFORM_DB_NAME, never from the URI path.
PLATFORM_MONGODB_URI=mongodb+srv://<username>:<password>@cluster-aws.oi55br0.mongodb.net/?appName=Cluster-aws

# Platform database name. Optional, defaults to logiforce_platform.
# PLATFORM_DB_NAME=logiforce_platform

# How long (ms) each server instance caches a company's record from the
# platform DB. A change to a company (e.g. suspending it) reaches a running
# server within this time. Unknown company keys are cached for 10 seconds.
# Optional, defaults to 60000 (1 minute).
# TENANT_CACHE_TTL_MS=60000

# First platform owner account, read by `npm run platform:seed`. The seed
# creates it if no account with this email exists, and never changes an
# existing account or its password. The password must be at least 12
# characters. You can remove these values once the owner exists.
# `npm run platform:create-owner` also reads PLATFORM_OWNER_PASSWORD when stdin
# is not a terminal (otherwise it asks for the password without echo).
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_NAME=
PLATFORM_OWNER_PASSWORD=

# Your own platform account, read by `npm run migrate:platform`. The account is
# created without a password and you get an emailed link to set one, which
# opens PLATFORM_CONSOLE_URL/set-password/<token> (the console page calls
# GET/POST /api/platform/auth/set-password). Never put a password here.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_NAME=
# Base URL of the platform console, used in set-password links. Required when
# a link is sent, e.g. https://platform.logiforce.app
PLATFORM_CONSOLE_URL=

# ─── Platform (product-owner) login ─────────────────────────────────────────
# REQUIRED. Signs the tokens of LogiForce staff who sign in at /api/platform.
# Must be at least 32 characters and different from JWT_SECRET, otherwise the
# server refuses to start. Generate one with:  openssl rand -hex 32
# Changing it signs out every platform session. Never log or commit it.
PLATFORM_JWT_SECRET=
# How long a platform token lasts. Optional, defaults to 8h.
PLATFORM_JWT_EXPIRES_IN=8h

# ─── Email delivery (Resend) ────────────────────────────────────────────────
# Sign up at https://resend.com and grab an API key. The free tier includes
# 3000 emails/month with no SMTP host/port/credentials to configure.
#
# IMPORTANT: the shared "onboarding@resend.dev" sender is in TESTING MODE — it
# will only deliver to the email address that owns the API key. To send OTPs
# and password-reset links to any other recipient you must verify your own
# domain at https://resend.com/domains and point EMAIL_FROM at it.
RESEND_API_KEY=

# Override the From header. Once you verify your domain in Resend, set this to
# something like "LogiForce <noreply@yourdomain.com>".
EMAIL_FROM=LogiForce <onboarding@resend.dev>

# Local development without a verified domain: set this to true to log emails
# (including OTP codes) to the server console instead of calling Resend. The
# registration and password-reset flows will succeed end to end. NEVER enable
# this in production.
EMAIL_DEV_LOG=false
