PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster-aws.oi55br0.mongodb.net/logiforce?appName=Cluster-aws
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_URL=https://logi-force.vercel.app

# SMTP — required for password reset emails. Without these, the
# "Reset password" admin action and "Forgot password" flow will fail
# with a clear "Email service is not configured" error instead of
# silently dropping the email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey-or-username
SMTP_PASS=your_smtp_password
# Display name + address shown in the email "From" header.
SMTP_FROM=LogiForce <no-reply@yourdomain.com>
