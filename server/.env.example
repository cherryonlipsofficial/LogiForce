PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster-aws.oi55br0.mongodb.net/logiforce?appName=Cluster-aws
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_URL=https://logi-force.vercel.app

# ─── Email delivery (Resend) ────────────────────────────────────────────────
# Sign up at https://resend.com and grab an API key. The free tier includes
# 3000 emails/month and the default sender "onboarding@resend.dev" works
# without any domain verification, so password-reset and OTP emails work
# out of the box. No SMTP host/port/credentials to configure.
RESEND_API_KEY=

# Optional: override the From header. Defaults to "LogiForce <onboarding@resend.dev>".
# Set this once you've verified your own domain in Resend.
EMAIL_FROM=LogiForce <onboarding@resend.dev>
