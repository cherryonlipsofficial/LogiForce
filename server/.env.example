# Copy to server/.env for `npm run dev` and the npm scripts.
#
# There are no per-company settings here. A fresh install has zero companies;
# the Platform Owner creates them in the platform console. See README.md.

PORT=5000
NODE_ENV=development

# ─── Databases ──────────────────────────────────────────────────────────────
# REQUIRED. Platform database: company list, platform users, platform roles
# and the platform audit log. The server will not start without it. It can be
# the same cluster as the companies: the database name always comes from
# PLATFORM_DB_NAME, never from the URI path.
PLATFORM_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=logiforce
# Platform database name. Optional, defaults to logiforce_platform.
# PLATFORM_DB_NAME=logiforce_platform

# REQUIRED. The cluster every company database lives on; a company's database
# is MONGODB_BASE_URI/<dbName>. No database name in it.
MONGODB_BASE_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net

# How long (ms) each server instance caches a company's record. A change to a
# company (e.g. suspending it) reaches every server within this time; the
# server that made the change sees it at once. Optional, defaults to 60000.
# TENANT_CACHE_TTL_MS=60000

# ─── Domain ─────────────────────────────────────────────────────────────────
# REQUIRED. Companies are served at https://<key>.<APP_DOMAIN> through a
# wildcard DNS record; invite and password links use it. The platform console
# is at https://admin.<APP_DOMAIN> unless PLATFORM_CONSOLE_URL says otherwise.
APP_DOMAIN=logiforce.app
# Optional: where platform set-password links point, e.g. https://admin.logiforce.app
# PLATFORM_CONSOLE_URL=

# Extra allowed CORS origins, comma-separated (optional). Every
# https://*.<APP_DOMAIN> and localhost origin is already allowed.
CLIENT_URL=

# ─── Tokens (REQUIRED) ──────────────────────────────────────────────────────
# Company-user tokens (aud 'tenant', bound to the company by `tid`).
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Platform-staff tokens (aud 'platform'). At least 32 characters and different
# from JWT_SECRET, otherwise the server refuses to start.
# Generate each with:  openssl rand -hex 32
# Changing one signs out every session of that kind. Never log or commit them.
PLATFORM_JWT_SECRET=
PLATFORM_JWT_EXPIRES_IN=8h

# ─── Email delivery (Resend) ────────────────────────────────────────────────
# Sign up at https://resend.com and grab an API key. Needed for sign-in codes
# and invite / password links.
#
# IMPORTANT: the shared "onboarding@resend.dev" sender is in TESTING MODE — it
# will only deliver to the email address that owns the API key. To send to
# anyone else, verify your own domain at https://resend.com/domains and point
# EMAIL_FROM at it.
RESEND_API_KEY=
EMAIL_FROM=LogiForce <onboarding@resend.dev>

# Local development without a verified domain: set this to true to log emails
# (including codes and links) to the server console instead of calling Resend.
# NEVER enable this in production.
EMAIL_DEV_LOG=false
